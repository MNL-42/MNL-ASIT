# Copie ce fichier en ".env" (cp env.example .env) puis remplis-le. Ne le partage JAMAIS.

# --- IA : clé API Groq (https://console.groq.com/keys) ---
GROQ_API_KEY=

# --- Email (IMAP/SMTP) : utilise un "mot de passe d'application", pas ton vrai mot de passe ---
EMAIL_ADDRESS=
EMAIL_PASSWORD=
IMAP_HOST=imap.gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Invente une phrase secrète, à recopier dans la config du webhook chez Meta
WHATSAPP_VERIFY_TOKEN=
# "Secret de l'application" (Meta for Developers > Paramètres > Général) : sert à vérifier les signatures
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v26.0

# --- Ports ---
WEBHOOK_PORT=8080
DASH_PORT=8787
